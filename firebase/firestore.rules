rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    function isRealUser() {
      return isAuthenticated() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function isTeacher() {
      return isRealUser() && exists(/databases/$(database)/documents/docenti_autorizzati/$(request.auth.uid))
        && get(/databases/$(database)/documents/docenti_autorizzati/$(request.auth.uid)).data.enabled == true;
    }
    function canViewStudent(uid) {
      return isTeacher() && exists(/databases/$(database)/documents/registri/$(uid));
    }
    match /docenti_autorizzati/{uid} {
      allow get: if isRealUser() && request.auth.uid == uid;
      allow list, write: if false;
    }
    // Solo i campi del profilo sono consultabili dai docenti già autorizzati al registro.
    match /account_preferences/{uid} {
      function isStudentProfileForTeacher() {
        return canViewStudent(uid)
          && (!exists(/databases/$(database)/documents/account_preferences/$(uid))
            || resource.data.keys().hasOnly(['givenName', 'familyName', 'photoData', 'updatedAt']));
      }
      function validPreferences() {
        let data = request.resource.data;
        return data.keys().hasAll(['updatedAt'])
          && data.keys().hasOnly(['givenName', 'familyName', 'photoData', 'updatedAt'])
          && data.updatedAt is timestamp && data.updatedAt == request.time
          && (!data.keys().hasAny(['givenName', 'familyName'])
            || (data.keys().hasAll(['givenName', 'familyName'])
              && data.givenName is string && data.givenName.size() > 0 && data.givenName.size() <= 80
              && data.familyName is string && data.familyName.size() > 0 && data.familyName.size() <= 80))
          && (!data.keys().hasAny(['photoData'])
            || (data.photoData is string && data.photoData.size() <= 180000
              && (data.photoData == '' || data.photoData.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}$'))));
      }
      allow get: if isRealUser() && (request.auth.uid == uid || isStudentProfileForTeacher());
      allow list, delete: if false;
      allow create, update: if isRealUser() && request.auth.uid == uid && validPreferences();
    }
    match /registri/{uid} {
      allow read: if isRealUser() && (request.auth.uid == uid || isTeacher());
      allow create: if isRealUser() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['studentId', 'email'])
        && request.resource.data.studentId is string
        && request.resource.data.email == request.auth.token.email.lower()
        && get(/databases/$(database)/documents/studenti/$(request.resource.data.studentId)).data.email.lower() == request.auth.token.email.lower();
      allow update, delete: if false;
    }
    function isEmailAvogadro() {
      return isRealUser() && request.auth.token.email != null &&
        (request.auth.token.email.matches('.*@studenti\\.itisavogadro\\.it') ||
         request.auth.token.email.matches('.*@itisavogadro\\.it'));
    }

    function isOwnProfile() {
      return isRealUser() && request.auth.token.email != null
        && resource.data.email is string
        && resource.data.email == request.auth.token.email.lower();
    }
    function isLinkedStudent() {
      return isRealUser() && request.auth.token.email != null
        && exists(/databases/$(database)/documents/registri/$(request.auth.uid))
        && get(/databases/$(database)/documents/registri/$(request.auth.uid)).data.email == request.auth.token.email.lower()
        && get(/databases/$(database)/documents/registri/$(request.auth.uid)).data.studentId is string;
    }
    // I profili sono consultabili solo dall'utente autenticato a cui appartengono.
    // I docenti abilitati possono leggere la lista studenti per il registro di classe.
    match /studenti/{studentId} {
      allow get: if isOwnProfile() || isTeacher();
      allow list: if isOwnProfile() || isTeacher();
      allow write: if false;
    }
    match /docenti/{teacherId} {
      allow get, list: if isOwnProfile();
      allow write: if false;
    }

    function validCalendarDate(value) {
      return value is string && value.matches('^([0-9]{4}-(01|03|05|07|08|10|12)-(0[1-9]|[12][0-9]|3[01])|[0-9]{4}-(04|06|09|11)-(0[1-9]|[12][0-9]|30)|[0-9]{4}-02-(0[1-9]|1[0-9]|2[0-8])|([0-9]{2}(0[48]|[2468][048]|[13579][26])|(0[48]|[2468][048]|[13579][26])00)-02-29)$');
    }
    function validActivity(data) {
      return data.titolo is string && data.titolo.size() > 0 && data.titolo.size() <= 120
        && data.descrizione is string && data.descrizione.size() <= 2000
        && validCalendarDate(data.data)
        && data.ore is number && data.ore > 0 && data.ore <= 10000
        && math.abs(data.ore * 100 - math.round(data.ore * 100)) <= 0.00000001
        && data.categoria in ['formazione', 'certificazioni'];
    }
    match /attivita_pcto/{activityId} {
      allow read: if (isLinkedStudent() && resource.data.ownerUid == request.auth.uid)
        || (isRealUser() && canViewStudent(resource.data.ownerUid));
      allow delete: if false;
      allow create: if isLinkedStudent()
        && request.resource.data.keys().hasAll(['ownerUid', 'titolo', 'descrizione', 'data', 'ore', 'categoria', 'createdAt'])
        && request.resource.data.keys().hasOnly(['ownerUid', 'titolo', 'descrizione', 'data', 'ore', 'categoria', 'createdAt', 'deleted'])
        && request.resource.data.get('deleted', false) == false
        && request.resource.data.ownerUid == request.auth.uid
        && validActivity(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isLinkedStudent() && resource.data.ownerUid == request.auth.uid
        && resource.data.get('deleted', false) == false
        && request.resource.data.updatedAt == request.time
        && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['titolo', 'descrizione', 'data', 'ore', 'categoria', 'updatedAt'])
              && validActivity(request.resource.data))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'deletedAt', 'updatedAt'])
              && request.resource.data.deleted == true && request.resource.data.deletedAt == request.time));
    }

    // Elenco iniziale condiviso: solo l'amministratore puo modificarlo.
    match /attivita_predefinite/{activityId} {
      allow read: if isLinkedStudent() || isTeacher();
      allow write: if false;
    }
    // Le modifiche e le cancellazioni riguardano esclusivamente il proprio registro.
    match /registri/{uid}/predefinite/{activityId} {
      allow read: if (isLinkedStudent() && request.auth.uid == uid)
        || (isRealUser() && canViewStudent(uid));
      function validOverride() {
        return request.resource.data.keys().hasAll(['titolo', 'descrizione', 'data', 'ore', 'categoria', 'deleted', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['titolo', 'descrizione', 'data', 'ore', 'categoria', 'deleted', 'updatedAt'])
          && request.resource.data.deleted == false && request.resource.data.updatedAt == request.time
          && validActivity(request.resource.data);
      }
      allow create: if isLinkedStudent() && request.auth.uid == uid
        && exists(/databases/$(database)/documents/attivita_predefinite/$(activityId))
        && (validOverride() || (request.resource.data.keys().hasOnly(['deleted', 'deletedAt', 'updatedAt'])
          && request.resource.data.deleted == true && request.resource.data.deletedAt == request.time && request.resource.data.updatedAt == request.time));
      allow update: if isLinkedStudent() && request.auth.uid == uid && resource.data.get('deleted', false) == false
        && (validOverride() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'deletedAt', 'updatedAt'])
          && request.resource.data.deleted == true && request.resource.data.deletedAt == request.time && request.resource.data.updatedAt == request.time));
      allow delete: if false;
    }

    // Messaggi: elenco volontario senza email, conversazioni private fra due utenti.
    function messagingAuthorized() {
      return isLinkedStudent() || isTeacher();
    }
    function messagingEnabled(uid) {
      return exists(/databases/$(database)/documents/messaging_profiles/$(uid))
        && get(/databases/$(database)/documents/messaging_profiles/$(uid)).data.enabled == true
        && ((get(/databases/$(database)/documents/messaging_profiles/$(uid)).data.role == 'studente'
            && exists(/databases/$(database)/documents/registri/$(uid)))
          || (get(/databases/$(database)/documents/messaging_profiles/$(uid)).data.role == 'docente'
            && exists(/databases/$(database)/documents/docenti_autorizzati/$(uid))
            && get(/databases/$(database)/documents/docenti_autorizzati/$(uid)).data.enabled == true));
    }
    function messagingUser() {
      return messagingAuthorized() && messagingEnabled(request.auth.uid);
    }
    match /messaging_profiles/{uid} {
      function validMessagingProfile() {
        let d = request.resource.data;
        return d.keys().hasAll(['name', 'role', 'photoData', 'enabled', 'updatedAt'])
          && d.keys().hasOnly(['name', 'role', 'photoData', 'enabled', 'updatedAt'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 640
          && ((d.role == 'docente' && isTeacher()) || (d.role == 'studente' && isLinkedStudent()))
          && d.photoData is string && d.photoData.size() <= 24000
          && (d.photoData == '' || d.photoData.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}$'))
          && d.enabled is bool && d.updatedAt == request.time;
      }
      allow get: if messagingAuthorized() && (request.auth.uid == uid || resource.data.enabled == true);
      allow list: if messagingUser() && resource.data.enabled == true && request.query.limit <= 200;
      allow create, update: if messagingAuthorized() && request.auth.uid == uid && validMessagingProfile();
      allow delete: if false;
    }
    match /conversations/{conversationId} {
      function member() {
        return messagingAuthorized()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;
      }
      function bothEnabled() {
        let members = get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;
        return messagingUser() && messagingEnabled(members[0]) && messagingEnabled(members[1]);
      }
      allow get: if messagingAuthorized()
        && (!exists(/databases/$(database)/documents/conversations/$(conversationId)) || request.auth.uid in resource.data.members);
      allow list: if messagingAuthorized() && request.auth.uid in resource.data.members && request.query.limit <= 100;
      allow create: if messagingUser()
        && request.resource.data.keys().hasAll(['members', 'createdBy', 'createdAt', 'updatedAt', 'lastText', 'lastSender', 'lastMessageId'])
        && request.resource.data.keys().hasOnly(['members', 'createdBy', 'createdAt', 'updatedAt', 'lastText', 'lastSender', 'lastMessageId'])
        && request.resource.data.members is list && request.resource.data.members.size() == 2
        && request.resource.data.members[0] is string && request.resource.data.members[1] is string
        && request.resource.data.members[0] != request.resource.data.members[1]
        && request.auth.uid in request.resource.data.members
        && conversationId == request.resource.data.members[0] + '~' + request.resource.data.members[1]
        && messagingEnabled(request.resource.data.members[0]) && messagingEnabled(request.resource.data.members[1])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && request.resource.data.lastText == '' && request.resource.data.lastSender == '' && request.resource.data.lastMessageId == '';
      function validChatUpdate() {
        let d = request.resource.data;
        let m = getAfter(/databases/$(database)/documents/conversations/$(conversationId)/messages/$(d.lastMessageId)).data;
        return d.diff(resource.data).affectedKeys().hasOnly(['lastText', 'lastSender', 'lastMessageId', 'updatedAt'])
          && d.lastMessageId is string && d.lastMessageId.size() > 0 && d.lastMessageId.size() <= 100
          && d.lastMessageId != resource.data.lastMessageId
          && d.lastText is string && d.lastText.size() > 0 && d.lastText.size() <= 8000 && d.lastText == m.text
          && d.lastSender == request.auth.uid && d.updatedAt == request.time
          && m.senderUid == request.auth.uid && m.createdAt == request.time;
      }
      allow update: if member() && bothEnabled() && validChatUpdate();
      allow delete: if false;
      match /messages/{messageId} {
        allow read: if member();
        function validMessage() {
          let d = request.resource.data;
          return d.keys().hasAll(['senderUid', 'text', 'replyTo', 'reactions', 'createdAt'])
            && d.keys().hasOnly(['senderUid', 'text', 'replyTo', 'reactions', 'createdAt'])
            && messageId.size() <= 100 && d.senderUid == request.auth.uid
            && d.text is string && d.text.size() > 0 && d.text.size() <= 8000 && d.text.matches('(?s).*[^\\s].*')
            && d.createdAt == request.time && d.reactions is map && d.reactions.size() == 0
            && d.replyTo is string && d.replyTo.size() <= 100
            && (d.replyTo == '' || exists(/databases/$(database)/documents/conversations/$(conversationId)/messages/$(d.replyTo)));
        }
        allow create: if member() && bothEnabled() && validMessage();
        allow update: if member() && bothEnabled()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.reactions is map
          && request.resource.data.reactions.keys().hasOnly(get(/databases/$(database)/documents/conversations/$(conversationId)).data.members)
          && request.resource.data.reactions.diff(resource.data.reactions).affectedKeys().hasOnly([request.auth.uid])
          && (!request.resource.data.reactions.keys().hasAny([request.auth.uid])
            || request.resource.data.reactions[request.auth.uid] in ['❤️', '👍', '👎', '😂', '‼️', '❓']);
        allow delete: if false;
      }
      match /states/{uid} {
        allow read: if member();
        allow create, update: if member() && bothEnabled() && request.auth.uid == uid
          && request.resource.data.keys().hasAll(['updatedAt'])
          && request.resource.data.keys().hasOnly(['isTyping', 'readAt', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && (!request.resource.data.keys().hasAny(['isTyping']) || request.resource.data.isTyping is bool)
          && (!request.resource.data.keys().hasAny(['readAt'])
            || (request.resource.data.readAt is timestamp && request.resource.data.readAt <= request.time));
        allow delete: if false;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
